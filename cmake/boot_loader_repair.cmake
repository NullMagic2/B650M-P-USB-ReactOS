# Module: xhci.build.boot_loader_repair
# Purpose: Relink only owned boot components against the matching saved loader SDK.
# Created: 2026-10-26
# Architecture: Read-only SDK inputs; all generated files stay in the new output.
cmake_minimum_required(VERSION 3.21)
foreach(input XHCI_FREELDR_RECIPE XHCI_FREELDR_OUTPUT)
    if(NOT DEFINED ${input})
        message(FATAL_ERROR "Missing ${input}")
    endif()
endforeach()
file(READ "${XHCI_FREELDR_RECIPE}" recipe)
string(JSON sdk GET "${recipe}" cwd)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(MAKE_DIRECTORY "${XHCI_FREELDR_OUTPUT}")
get_filename_component(output "${XHCI_FREELDR_OUTPUT}" ABSOLUTE)
foreach(kind compile link)
    string(JSON count LENGTH "${recipe}" ${kind})
    math(EXPR last "${count} - 1")
    set(${kind})
    foreach(index RANGE 0 ${last})
        string(JSON arg GET "${recipe}" ${kind} ${index})
        list(APPEND ${kind} "${arg}")
    endforeach()
endforeach()
set(sources "${root}/compat/reactos/freeldr/boot_disk.cpp"
    "${root}/compat/reactos/freeldr/bios_disk_buffer.cpp"
    "${root}/compat/reactos/freeldr/bios_disk_io.cpp"
    "${root}/compat/reactos/freeldr/bios_startup.cpp"
    "${root}/compat/reactos/freeldr/disk_registration.cpp"
    "${root}/src/tools/boot_loader_diagnostics.cpp")
if(DEFINED XHCI_FREELDR_TEST_SOURCE)
    list(APPEND sources "${XHCI_FREELDR_TEST_SOURCE}")
endif()
if(XHCI_FREELDR_USB_PIC_HANDOFF)
    list(APPEND sources "${root}/compat/reactos/freeldr/usb_pic_handoff.cpp")
    list(APPEND compile "-DXHCI_FREELDR_USB_PIC_HANDOFF=1")
endif()
set(objects)
foreach(source IN LISTS sources)
    get_filename_component(name "${source}" NAME_WE)
    set(command ${compile})
    list(FIND command "-o" index)
    math(EXPR index "${index} + 1")
    list(REMOVE_AT command ${index})
    list(INSERT command ${index} "${output}/${name}.obj")
    list(FIND command "-c" index)
    math(EXPR index "${index} + 1")
    list(REMOVE_AT command ${index})
    list(INSERT command ${index} "${source}")
    if(DEFINED XHCI_FREELDR_TEST_MODE)
        list(APPEND command "-DXHCI_FREELDR_TEST_MODE=${XHCI_FREELDR_TEST_MODE}")
    endif()
    execute_process(COMMAND ${command} WORKING_DIRECTORY "${sdk}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Boot component compilation failed: ${name}")
    endif()
    list(APPEND objects "${output}/${name}.obj")
endforeach()
list(FILTER link EXCLUDE REGEX "/boot_loader_diagnostics\\.obj$")
list(FILTER link EXCLUDE REGEX "^-Wl,-Map,")
list(FIND link "-o" index)
math(EXPR index "${index} + 1")
list(REMOVE_AT link ${index})
list(INSERT link ${index} "${output}/freeldr-pe.exe")
list(INSERT link 1 ${objects})
list(APPEND link "-Wl,--wrap,DiskInitialize" "-Wl,--wrap,PcMemGetMemoryMap"
    "-Wl,--wrap,HalpCalibrateStallExecution"
    "-Wl,--wrap,PcDiskReadLogicalSectors" "-Wl,-Map,${output}/freeldr.map")
if(DEFINED XHCI_FREELDR_TEST_WRAP)
    foreach(symbol IN LISTS XHCI_FREELDR_TEST_WRAP)
        list(APPEND link "-Wl,--wrap,${symbol}")
    endforeach()
endif()
execute_process(COMMAND ${link} WORKING_DIRECTORY "${sdk}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Boot component link failed")
endif()
find_program(strip_tool i686-w64-mingw32-strip REQUIRED)
execute_process(COMMAND "${strip_tool}" --strip-all "${output}/freeldr-pe.exe"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Boot loader strip failed")
endif()
execute_process(COMMAND /bin/sh -c "cat \"$1\" \"$2\" > \"$3\"" --
    "${sdk}/boot/freeldr/freeldr/frldr16.bin" "${output}/freeldr-pe.exe"
    "${output}/freeldr.sys" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Split loader assembly failed")
endif()
file(SHA256 "${output}/freeldr.sys" digest)
file(WRITE "${output}/SHA256SUMS" "${digest}  freeldr.sys\n")
message(STATUS "Boot loader built: ${output}/freeldr.sys (${digest})")
