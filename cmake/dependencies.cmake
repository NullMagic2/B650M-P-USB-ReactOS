# Module: xhci.build.dependencies
# Purpose: Fetch only pinned native SDK and selected component build inputs.
# Created: 2026-10-26
# Architecture: Source checkout stays independent of whole ReactOS source/build trees.
option(XHCI_DOWNLOAD_DEPENDENCIES "Fetch missing checksum-pinned native dependencies" ON)
set(XHCI_DEPENDENCIES_DIR "${PROJECT_SOURCE_DIR}/dependencies" CACHE PATH "Native build dependency cache")
get_filename_component(dependency_root "${XHCI_DEPENDENCIES_DIR}/reactos-i386-a97c8a2-v1" ABSOLUTE)
set(dependency_source "${dependency_root}/source")
set(dependency_build "${dependency_root}/build")
# Explicit external SDK paths remain supported; mixed external/cache paths are rejected.
if(XHCI_REACTOS_SOURCE OR XHCI_REACTOS_BUILD)
    if(NOT XHCI_REACTOS_SOURCE OR NOT XHCI_REACTOS_BUILD)
        message(FATAL_ERROR "Provide both XHCI_REACTOS_SOURCE and XHCI_REACTOS_BUILD, or neither for automatic dependencies")
    endif()
    get_filename_component(selected_source "${XHCI_REACTOS_SOURCE}" ABSOLUTE)
    get_filename_component(selected_build "${XHCI_REACTOS_BUILD}" ABSOLUTE)
    if(NOT selected_source STREQUAL dependency_source OR NOT selected_build STREQUAL dependency_build)
        if(selected_source STREQUAL dependency_source OR selected_build STREQUAL dependency_build)
            message(FATAL_ERROR "Do not mix an external SDK with the automatic dependency cache")
        endif()
        return()
    endif()
endif()
file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" dependency_lock)
string(JSON dependency_url GET "${dependency_lock}" download_base)
function(xhci_fetch_dependency component)
    string(JSON filename GET "${dependency_lock}" components "${component}" filename)
    string(JSON expected GET "${dependency_lock}" components "${component}" sha256)
    string(JSON expected_manifest GET "${dependency_lock}" components "${component}" manifest_sha256)
    set(manifest "${dependency_root}/manifest-${component}.json")
    if(NOT EXISTS "${manifest}")
        set(archive "${XHCI_DEPENDENCIES_DIR}/downloads/${filename}")
        if(NOT EXISTS "${archive}")
            if(NOT XHCI_DOWNLOAD_DEPENDENCIES)
                message(FATAL_ERROR "Missing ${component} dependencies. Enable XHCI_DOWNLOAD_DEPENDENCIES or provide a matching external SDK")
            endif()
            file(MAKE_DIRECTORY "${XHCI_DEPENDENCIES_DIR}/downloads")
            message(STATUS "Downloading pinned ReactOS ${component} build dependencies")
            file(DOWNLOAD "${dependency_url}/${filename}" "${archive}.download"
                EXPECTED_HASH "SHA256=${expected}" TLS_VERIFY ON
                TIMEOUT 180 INACTIVITY_TIMEOUT 30 STATUS status SHOW_PROGRESS)
            list(GET status 0 result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Dependency download failed: ${status}. Retry configure or use a matching external SDK")
            endif()
            file(RENAME "${archive}.download" "${archive}")
        endif()
        file(SHA256 "${archive}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Dependency archive checksum mismatch: ${archive}; replace this cached file before retrying")
        endif()
        file(MAKE_DIRECTORY "${dependency_root}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${dependency_root}")
    endif()
    file(SHA256 "${manifest}" actual_manifest)
    if(NOT actual_manifest STREQUAL expected_manifest)
        message(FATAL_ERROR "Cached ${component} dependency manifest differs from dependencies.lock.json")
    endif()
    file(READ "${manifest}" contents)
    string(JSON count LENGTH "${contents}" files)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON path GET "${contents}" files ${index} path)
        string(JSON expected_file GET "${contents}" files ${index} sha256)
        if(NOT EXISTS "${dependency_root}/${path}")
            message(FATAL_ERROR "Missing cached dependency: ${path}; restore this cache component")
        endif()
        file(SHA256 "${dependency_root}/${path}" actual_file)
        if(NOT actual_file STREQUAL expected_file)
            message(FATAL_ERROR "Cached dependency checksum mismatch: ${path}")
        endif()
    endforeach()
    message(STATUS "Verified ${component} dependencies (${count} files)")
endfunction()
if(XHCI_NATIVE_DIAGNOSTIC OR XHCI_NATIVE_CONTROLLER OR XHCI_NATIVE_BOOT OR XHCI_NATIVE_USB_COMPATIBILITY)
    xhci_fetch_dependency(sdk)
endif()
if(XHCI_NATIVE_USB_COMPATIBILITY)
    if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
        message(FATAL_ERROR "Automatic USB compatibility dependencies currently require a Linux x86_64 host; use an external matching SDK on other hosts")
    endif()
    xhci_fetch_dependency(usb)
endif()
if(XHCI_IMAGE_TOOLS)
    xhci_fetch_dependency(image)
endif()
set(XHCI_REACTOS_SOURCE "${dependency_source}" CACHE PATH "Matching ReactOS headers/component sources" FORCE)
set(XHCI_REACTOS_BUILD "${dependency_build}" CACHE PATH "Matching generated headers/import libraries" FORCE)
