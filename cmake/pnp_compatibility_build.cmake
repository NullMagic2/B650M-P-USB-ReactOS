# Module: reactos.build.pnp_parent_lifetime
# Purpose: Relink an owned qualification kernel using a read-only exact SDK.
# Created: 2026-10-25
# Architecture: Recompile patched devnode/plugplay and the C++ lifetime owner.
# This is an experimental qualification output, never an automatic SDK update.
cmake_minimum_required(VERSION 3.20)
foreach(required XHCI_REACTOS_SOURCE XHCI_REACTOS_BUILD XHCI_COMPAT_ROOT XHCI_PNP_OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
get_filename_component(output "${XHCI_PNP_OUTPUT}" ABSOLUTE)
get_filename_component(sdk "${XHCI_REACTOS_BUILD}" ABSOLUTE)
get_filename_component(owned "${XHCI_COMPAT_ROOT}/Binaries/.build" ABSOLUTE)
cmake_path(IS_PREFIX owned "${output}" NORMALIZE is_owned)
cmake_path(IS_PREFIX sdk "${output}" NORMALIZE is_sdk)
if(NOT is_owned OR is_sdk OR EXISTS "${output}/ntoskrnl-pnp-i386.exe")
    message(FATAL_ERROR "Use a fresh owned output directory outside the read-only SDK")
endif()
file(SHA256 "${sdk}/ntoskrnl/ntoskrnl.exe" baseline)
if(NOT baseline STREQUAL "2cbf353890304819960a5fb94752c42aa56dac700d809da3b0e571a1bcbaeedc")
    message(FATAL_ERROR "Unreviewed installed-OS kernel baseline")
endif()
file(READ "${sdk}/build.ninja" ninja)
function(read_block key result)
    string(FIND "${ninja}" "build ${key}: " begin)
    if(begin LESS 0)
        message(FATAL_ERROR "Missing SDK build target ${key}")
    endif()
    string(SUBSTRING "${ninja}" ${begin} -1 tail)
    string(FIND "${tail}" "\n\n" end)
    string(SUBSTRING "${tail}" 0 ${end} block)
    set(${result} "${block}" PARENT_SCOPE)
endfunction()
function(read_field block name result)
    string(REGEX MATCH "\n  ${name} = ([^\n]*)" match "${block}")
    if(NOT match)
        message(FATAL_ERROR "Missing SDK field ${name}")
    endif()
    separate_arguments(args UNIX_COMMAND "${CMAKE_MATCH_1}")
    set(${result} "${args}" PARENT_SCOPE)
endfunction()
read_block("ntoskrnl/CMakeFiles/ntoskrnl.dir/io/pnpmgr/devnode.c.obj" compile)
read_field("${compile}" DEFINES defines)
read_field("${compile}" FLAGS flags)
read_field("${compile}" INCLUDES includes)
file(READ "${sdk}/CMakeCache.txt" cache)
foreach(language C CXX)
    string(REGEX MATCH "CMAKE_${language}_COMPILER:[^=]*=([^\n]+)" match "${cache}")
    if(NOT match)
        message(FATAL_ERROR "SDK compiler missing")
    endif()
    set(compiler_${language} "${CMAKE_MATCH_1}")
endforeach()
file(MAKE_DIRECTORY "${output}/source/ntoskrnl/io/pnpmgr")
file(COPY "${XHCI_REACTOS_SOURCE}/ntoskrnl/io/pnpmgr/devnode.c"
    "${XHCI_REACTOS_SOURCE}/ntoskrnl/io/pnpmgr/plugplay.c"
    DESTINATION "${output}/source/ntoskrnl/io/pnpmgr")
execute_process(COMMAND patch --batch --fuzz=0 -p1 -i
    "${XHCI_COMPAT_ROOT}/compat/reactos/pnp-parent-lifetime.patch"
    WORKING_DIRECTORY "${output}/source" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Exact PnP compatibility patch failed")
endif()
set(header "${XHCI_COMPAT_ROOT}/compat/reactos/pnp")
foreach(input devnode plugplay)
    execute_process(COMMAND "${compiler_C}" ${defines} ${flags} ${includes}
        "-I${header}" -c "${output}/source/ntoskrnl/io/pnpmgr/${input}.c"
        -o "${output}/${input}.obj" WORKING_DIRECTORY "${sdk}" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Patched ${input} compile failed")
    endif()
endforeach()
list(REMOVE_ITEM flags -std=gnu99 -Wold-style-declaration)
execute_process(COMMAND "${compiler_CXX}" ${defines} ${flags} ${includes}
    -std=c++17 -fno-exceptions -fno-rtti "-I${header}"
    -c "${header}/parent_lifetime.cpp" -o "${output}/parent_lifetime.obj"
    WORKING_DIRECTORY "${sdk}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Parent lifetime C++ compile failed")
endif()
read_block("ntoskrnl/ntoskrnl.exe" link)
string(REGEX MATCH "^[^\n]+" first "${link}")
string(REGEX REPLACE "^build [^:]+: [^ ]+ " "" object_text "${first}")
string(REGEX REPLACE " \\|.*$" "" object_text "${object_text}")
separate_arguments(objects UNIX_COMMAND "${object_text}")
list(REMOVE_ITEM objects "ntoskrnl/CMakeFiles/ntoskrnl.dir/io/pnpmgr/devnode.c.obj"
    "ntoskrnl/CMakeFiles/ntoskrnl.dir/io/pnpmgr/plugplay.c.obj")
list(APPEND objects "${output}/devnode.obj" "${output}/plugplay.obj" "${output}/parent_lifetime.obj")
read_field("${link}" LINK_FLAGS link_flags)
read_field("${link}" LINK_LIBRARIES libraries)
set(binary "${output}/ntoskrnl-pnp-i386.exe")
execute_process(COMMAND "${compiler_CXX}" ${link_flags} ${objects} ${libraries}
    -o "${binary}" WORKING_DIRECTORY "${sdk}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Qualification kernel link failed")
endif()
execute_process(COMMAND "${sdk}/host-tools/bin/pefixup" --kernel "${binary}"
    RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Kernel image fixup failed")
endif()
file(SHA256 "${sdk}/ntoskrnl/ntoskrnl.exe" unchanged)
if(NOT unchanged STREQUAL baseline)
    message(FATAL_ERROR "External SDK kernel unexpectedly changed")
endif()
file(SHA256 "${binary}" identity)
file(WRITE "${output}/IDENTITY.txt"
    "Module: reactos.validation.pnp_parent_lifetime\nBaselineSHA256=${baseline}\nCandidateSHA256=${identity}\nExperimental qualification kernel; runtime unqualified.\n")
message(STATUS "Qualification kernel SHA256=${identity}; SDK unchanged")
