# Module: xhci.build.offline_image_update
# Purpose: Preserve a stopped persistent image while assembling a separate upgraded copy.
# Created: 2026-10-25
# Architecture: Approved old hashes and an immutable original make rollback a file selection.
cmake_minimum_required(VERSION 3.21)
foreach(input XHCI_OLD_IMAGE XHCI_OLD_IMAGE_SHA256 XHCI_UPDATE_OUTPUT XHCI_PACKAGE_CATALOG
    XHCI_IMAGE_ASSEMBLER XHCI_REACTOS_BUILD XHCI_IMAGE_SECTORS XHCI_IMAGE_SIGNATURE)
    if(NOT DEFINED ${input} OR "${${input}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${input}")
    endif()
endforeach()
if(EXISTS "${XHCI_UPDATE_OUTPUT}" OR IS_SYMLINK "${XHCI_OLD_IMAGE}")
    message(FATAL_ERROR "Preserve original outputs and refuse redirected image inputs")
endif()
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/../Binaries/.build" allowed)
get_filename_component(output "${XHCI_UPDATE_OUTPUT}" ABSOLUTE)
string(FIND "${output}/" "${allowed}/" contained)
if(NOT contained EQUAL 0 OR IS_DIRECTORY "${XHCI_OLD_IMAGE}" OR NOT EXISTS "${XHCI_OLD_IMAGE}")
    message(FATAL_ERROR "Upgrade needs a stopped regular image and new staging inside Binaries/.build")
endif()
file(SIZE "${XHCI_OLD_IMAGE}" image_size)
math(EXPR expected_size "(${XHCI_IMAGE_SECTORS} + 2048) * 512")
if(NOT image_size EQUAL expected_size)
    message(FATAL_ERROR "Stopped image size does not match its approved partition layout")
endif()
file(SHA256 "${XHCI_OLD_IMAGE}" before)
if(NOT before STREQUAL XHCI_OLD_IMAGE_SHA256)
    message(FATAL_ERROR "Stopped original image differs from the selected immutable identity")
endif()
file(MAKE_DIRECTORY "${XHCI_UPDATE_OUTPUT}/tree")
find_program(seven_zip 7z REQUIRED)
execute_process(COMMAND "${seven_zip}" x -y "-o${XHCI_UPDATE_OUTPUT}/tree" "${XHCI_OLD_IMAGE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE extraction ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Original FAT extraction is not clean; no upgrade is published. ${errors}")
endif()
file(READ "${XHCI_PACKAGE_CATALOG}/catalog.json" catalog)
string(JSON packages LENGTH "${catalog}" packages)
math(EXPR last "${packages} - 1")
foreach(p RANGE 0 ${last})
    string(JSON files LENGTH "${catalog}" packages ${p} files)
    math(EXPR file_last "${files} - 1")
    foreach(f RANGE 0 ${file_last})
        string(JSON destination GET "${catalog}" packages ${p} files ${f} destination)
        if(destination MATCHES "^system32/drivers/(xhci|usbhub|usbstor|disk|hidusb)\\.sys$")
            string(JSON source GET "${catalog}" packages ${p} files ${f} source)
            string(JSON expected GET "${catalog}" packages ${p} files ${f} sha256)
            if(source MATCHES "(^/|\\.\\.|\\\\|:)")
                message(FATAL_ERROR "Unsafe provider path")
            endif()
            set(target "${XHCI_UPDATE_OUTPUT}/tree/ReactOS/${destination}")
            file(SHA256 "${target}" old)
            file(SHA256 "${XHCI_PACKAGE_CATALOG}/${source}" actual)
            string(JSON previous LENGTH "${catalog}" packages ${p} files ${f} previous_sha256)
            set(approved FALSE)
            if(old STREQUAL expected)
                set(approved TRUE)
            elseif(previous GREATER 0)
                math(EXPR previous_last "${previous} - 1")
                foreach(index RANGE 0 ${previous_last})
                    string(JSON candidate GET "${catalog}" packages ${p} files ${f} previous_sha256 ${index})
                    if(old STREQUAL candidate)
                        set(approved TRUE)
                    endif()
                endforeach()
            endif()
            if(NOT approved OR NOT actual STREQUAL expected)
                message(FATAL_ERROR "Unknown old or changed new payload: ${destination}")
            endif()
            file(COPY_FILE "${XHCI_PACKAGE_CATALOG}/${source}" "${target}")
        endif()
    endforeach()
endforeach()
# Preserve actual user and registry state. The active boot bridge must keep the
# same selected MBR identity/partition. This catalog update replaces only its five
# runtime modules; a boot bridge/policy change requires full new image assembly.
file(READ "${XHCI_OLD_IMAGE}" mbr HEX OFFSET 440 LIMIT 72)
string(SUBSTRING "${mbr}" 0 8 old_signature)
string(SUBSTRING "${mbr}" 28 8 old_start)
if(NOT old_start STREQUAL "00080000")
    message(FATAL_ERROR "Original is not the expected single native USB partition")
endif()
set(new_image "${XHCI_UPDATE_OUTPUT}/ReactOS-persistent-usb-upgraded.img")
set(config "${XHCI_UPDATE_OUTPUT}/tree/ReactOS/system32/config")
if(EXISTS "${config}/SYSTEM" AND NOT EXISTS "${config}/system")
    file(RENAME "${config}/SYSTEM" "${config}/system")
endif()
execute_process(COMMAND "${XHCI_IMAGE_ASSEMBLER}" "${new_image}" "${XHCI_UPDATE_OUTPUT}/tree"
    "${XHCI_REACTOS_BUILD}/boot/freeldr/bootsect/dosmbr.bin"
    "${XHCI_REACTOS_BUILD}/boot/freeldr/bootsect/fat32.bin" "${XHCI_IMAGE_SECTORS}" "${XHCI_IMAGE_SIGNATURE}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Upgrade assembly failed; original remains preserved")
endif()
file(READ "${new_image}" mbr_after HEX OFFSET 440 LIMIT 72)
if(NOT mbr_after STREQUAL mbr)
    message(FATAL_ERROR "Upgrade changed boot identity/partition; candidate is rejected")
endif()
file(SHA256 "${XHCI_OLD_IMAGE}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Original changed during extraction; candidate is rejected")
endif()
file(SHA256 "${new_image}" checksum)
file(WRITE "${XHCI_UPDATE_OUTPUT}/SHA256SUMS.txt" "${checksum}  ReactOS-persistent-usb-upgraded.img\n")
