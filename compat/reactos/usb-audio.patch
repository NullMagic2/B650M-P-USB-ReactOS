+/* A stream irp stays pending as long as a stream pointer refers to it. The
+ * count lives in the irp, which is ours from the moment it leaves the queue.
+ */
+static
+VOID
+IKsPin_ReleaseIrp(
+    IN PIRP Irp)
+{
+    if (InterlockedDecrement((PLONG)&Irp->Tail.Overlay.DriverContext[0]) == 0)
+    {
+        Irp->IoStatus.Information = IoGetCurrentIrpStackLocation(Irp)->Parameters.DeviceIoControl.OutputBufferLength;
+        CompleteRequest(Irp, IO_SOUND_INCREMENT);
+    }
+}
+
+/* Hands back every frame the pin still holds. The processing mutex is held. */
+static
+VOID
+IKsPin_Flush(
+    IN IKsPinImpl * This)
+{
+    PIRP Irp;
+
+    if (This->LeadingEdgeStreamPointer.Irp)
+    {
+        IKsPin_ReleaseIrp(This->LeadingEdgeStreamPointer.Irp);
+        This->LeadingEdgeStreamPointer.Irp = NULL;
+    }
+
+    for (;;)
+    {
+        Irp = KsRemoveIrpFromCancelableQueue(&This->IrpList, &This->IrpListLock, KsListEntryHead, KsAcquireAndRemoveOnlySingleItem);
+        if (!Irp)
+            break;
+
+        InterlockedDecrement(&This->IrpCount);
+        Irp->IoStatus.Status = STATUS_SUCCESS;
+        Irp->IoStatus.Information = IoGetCurrentIrpStackLocation(Irp)->Parameters.DeviceIoControl.OutputBufferLength;
+        CompleteRequest(Irp, IO_NO_INCREMENT);
+    }
+}
