+/* Controls of a feature unit: channel 0 is the master, the others are the
+ * logical channels of the unit, counted from 1.
+ */
+static
+UCHAR
+UsbAudioFeatureControls(
+    IN PUSB_AUDIO_CONTROL_FEATURE_UNIT_DESCRIPTOR FeatureUnitDescriptor,
+    IN ULONG Channel)
+{
+    ULONG Size = FeatureUnitDescriptor->bControlSize;
+
+    if (Size == 0 || FeatureUnitDescriptor->bLength < 7 + (Channel + 1) * Size)
+    {
+        return 0;
+    }
+
+    return FeatureUnitDescriptor->bmaControls[Channel * Size];
+}
+
+/* Runs one request on every usb channel which stands for the channel the
+ * client names: that channel if the unit controls it by itself, the master
+ * if not, and with no master every channel when all of them are meant.
+ * A read is answered by the first of them.
+ */
+static
+NTSTATUS
+UsbAudioFeatureRequest(
+    IN PFILTER_CONTEXT FilterContext,
+    IN PUSB_AUDIO_CONTROL_FEATURE_UNIT_DESCRIPTOR FeatureUnitDescriptor,
+    IN LONG Channel,
+    IN UCHAR Request,
+    IN UCHAR ControlSelector,
+    IN PVOID TransferBuffer,
+    IN ULONG TransferBufferLength)
+{
+    UCHAR ControlBit = 1 << (ControlSelector - 1);
+    ULONG TransferFlags = (Request & 0x80) ? USBD_TRANSFER_DIRECTION_IN : USBD_TRANSFER_DIRECTION_OUT;
+    USHORT Index = (FeatureUnitDescriptor->bUnitID << 8) | FilterContext->DeviceExtension->ControlInterfaceNumber;
+    NTSTATUS Status = STATUS_NOT_SUPPORTED;
+    ULONG UsbChannel;
+
+    if (Channel >= 0 && (UsbAudioFeatureControls(FeatureUnitDescriptor, Channel + 1) & ControlBit))
+    {
+        return UsbAudioGetSetProperty(FilterContext->DeviceExtension->LowerDevice, Request, (ControlSelector << 8) | (Channel + 1), Index, TransferBuffer, TransferBufferLength, TransferFlags);
+    }
+
+    if (UsbAudioFeatureControls(FeatureUnitDescriptor, 0) & ControlBit)
+    {
+        return UsbAudioGetSetProperty(FilterContext->DeviceExtension->LowerDevice, Request, ControlSelector << 8, Index, TransferBuffer, TransferBufferLength, TransferFlags);
+    }
+
+    if (Channel >= 0)
+    {
+        return STATUS_NOT_SUPPORTED;
+    }
+
+    for (UsbChannel = 1; UsbChannel < 32; UsbChannel++)
+    {
+        if (!(UsbAudioFeatureControls(FeatureUnitDescriptor, UsbChannel) & ControlBit))
+        {
+            continue;
+        }
+
+        Status = UsbAudioGetSetProperty(FilterContext->DeviceExtension->LowerDevice, Request, (ControlSelector << 8) | UsbChannel, Index, TransferBuffer, TransferBufferLength, TransferFlags);
+        if (!NT_SUCCESS(Status) || (Request & 0x80))
+        {
+            break;
+        }
+    }
+
+    return Status;
+}
