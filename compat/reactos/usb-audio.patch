+NTSTATUS
+NTAPI
+UsbAudioPinPositionHandler(
+    IN PIRP Irp,
+    IN PKSIDENTIFIER Request,
+    IN OUT PVOID Data)
+{
+    PKSAUDIO_POSITION Position = Data;
+    PPIN_CONTEXT PinContext;
+    PKSPIN Pin;
+    KIRQL OldLevel;
+
+    Pin = KsGetPinFromIrp(Irp);
+    if (!Pin || !Pin->Context)
+    {
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    if (!(Request->Flags & KSPROPERTY_TYPE_GET))
+    {
+        /* the position follows the stream */
+        return STATUS_NOT_SUPPORTED;
+    }
+
+    PinContext = Pin->Context;
+
+    KeAcquireSpinLock(&PinContext->Lock, &OldLevel);
+    Position->PlayOffset = PinContext->BytesDone;
+    Position->WriteOffset = (Pin->DataFlow == KSPIN_DATAFLOW_IN) ? PinContext->BytesQueued : PinContext->BytesDone;
+    KeReleaseSpinLock(&PinContext->Lock, OldLevel);
+
+    Irp->IoStatus.Information = sizeof(KSAUDIO_POSITION);
+    return STATUS_SUCCESS;
+}
