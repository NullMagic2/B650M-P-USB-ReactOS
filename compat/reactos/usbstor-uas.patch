+// The UAS transport has stored the command's result in its SRB
+VOID
+NTAPI
+USBSTOR_UasDone(
+    IN PDEVICE_OBJECT FdoDevice,
+    IN PIRP Irp)
+{
+    PIO_STACK_LOCATION IoStack = IoGetCurrentIrpStackLocation(Irp);
+    PSCSI_REQUEST_BLOCK Request = IoStack->Parameters.Scsi.Srb;
+    UCHAR SrbStatus = SRB_STATUS(Request->SrbStatus);
+
+    if (SrbStatus == SRB_STATUS_SUCCESS || SrbStatus == SRB_STATUS_DATA_OVERRUN)
+    {
+        Irp->IoStatus.Status = USBSTOR_SrbStatusToNtStatus(Request);
+    }
+    else
+    {
+        Irp->IoStatus.Status = STATUS_IO_DEVICE_ERROR;
+    }
+    Irp->IoStatus.Information = Request->DataTransferLength;
+
+    // Same order as the bulk-only completion: the queue is released before
+    // the class driver sees the result. A retry sent from its completion
+    // routine would otherwise find the device queue still busy and never start.
+    USBSTOR_QueueTerminateRequest(FdoDevice, Irp);
+    USBSTOR_QueueNextRequest(FdoDevice);
+    IoCompleteRequest(Irp, IO_NO_INCREMENT);
+}
