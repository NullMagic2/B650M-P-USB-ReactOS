+static VOID
+HalpWaitForReset(VOID)
+{
+    ULONG i;
+
+    /* Give the requested reset 100 ms to happen. Interrupts are disabled. */
+    for (i = 0; i < 100; i++)
+        KeStallExecutionProcessor(1000);
+}
