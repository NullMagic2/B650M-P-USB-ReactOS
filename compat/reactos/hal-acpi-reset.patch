+/*
+ * Requests a system reset through the reset register of the FADT.
+ * Called by HalpReboot with interrupts disabled. Returns FALSE if the
+ * firmware does not describe a usable reset register, TRUE once the
+ * reset value has been written (the reset itself may take a moment).
+ */
+BOOLEAN
+NTAPI
+HalpAcpiResetSystem(VOID)
+{
+    PFADT Fadt = &HalpFixedAcpiDescTable;
+    ULONGLONG Address = Fadt->reset_reg.Address.QuadPart;
+    PHYSICAL_ADDRESS PhysicalAddress;
+    PUCHAR Mapping;
+    ULONG Device, Function, Offset;
+
+    /* The register exists since revision 2 of the table, and is optional */
+    if (!HalpProcessedACPIPhase0 ||
+        (Fadt->Header.Revision < 2) ||
+        (Fadt->Header.Length < RTL_SIZEOF_THROUGH_FIELD(FADT, reset_val)) ||
+        !(Fadt->flags & RESET_CAP) ||
+        (Address == 0))
+    {
+        return FALSE;
+    }
+
+    /* The register is one byte wide in any of the three allowed spaces */
+    switch (Fadt->reset_reg.AddressSpaceID)
+    {
+        /* System memory */
+        case 0:
+        {
+            PhysicalAddress.QuadPart = Address;
+            Mapping = HalpMapPhysicalMemory64(PhysicalAddress, 1);
+            if (!Mapping) return FALSE;
+
+            WRITE_REGISTER_UCHAR(Mapping + BYTE_OFFSET(PhysicalAddress.LowPart),
+                                 Fadt->reset_val);
+            return TRUE;
+        }
+
+        /* System I/O */
+        case 1:
+        {
+            if (Address > 0xFFFF) return FALSE;
+
+            WRITE_PORT_UCHAR((PUCHAR)(ULONG_PTR)Address, Fadt->reset_val);
+            return TRUE;
+        }
+
+        /* PCI configuration space of bus 0: device, function and offset */
+        case 2:
+        {
+            Device = (ULONG)(Address >> 32) & 0xFFFF;
+            Function = (ULONG)(Address >> 16) & 0xFFFF;
+            Offset = (ULONG)Address & 0xFFFF;
+            if ((Device > 31) || (Function > 7) || (Offset > 0xFF)) return FALSE;
+
+            WRITE_PORT_ULONG((PULONG)0xCF8,
+                             0x80000000 | (Device << 11) | (Function << 8) | (Offset & 0xFC));
+            WRITE_PORT_UCHAR((PUCHAR)(ULONG_PTR)(0xCFC + (Offset & 3)), Fadt->reset_val);
+            return TRUE;
+        }
+
+        default:
+            return FALSE;
+    }
+}
